{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.development.local)",
      "Read(secrets/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for f in docs/PROJECT_STATE.md docs/NEXT_ACTIONS.md; do [ -f \"$f\" ] && { echo \"--- $f ---\"; cat \"$f\"; }; done"
          }
        ]
      }
    ]
  }
}
